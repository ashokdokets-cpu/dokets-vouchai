generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  phone          String   @unique
  name           String
  email          String?
  language       String   @default("en")
  role           String   @default("BOTH")
  country        String   @default("IN")
  vouchScore     Float    @default(100)
  vouchTier      String   @default("NEW")
  isPremium      Boolean  @default(false)
  referralCode   String   @unique
  walletBalance  Float    @default(0)
  walletCurrency String   @default("INR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contractsAsClient   Contract[] @relation("ClientContracts")
  contractsAsProvider Contract[] @relation("ProviderContracts")
  reviewsGiven        Review[]   @relation("Reviewer")
  reviewsReceived     Review[]   @relation("Reviewee")
  disputesRaised      Dispute[]  @relation("DisputeRaiser")
  disputesAgainst     Dispute[]  @relation("DisputeAgainst")
}

model Contract {
  id            String    @id @default(cuid())
  vouchId       String    @unique
  title         String
  description   String
  category      String?
  status        String    @default("DRAFT")
  amount        Float
  currency      String    @default("INR")
  upfrontAmount Float?
  finalAmount   Float
  clientId      String
  client        User      @relation("ClientContracts", fields: [clientId], references: [id])
  providerId    String?
  provider      User?     @relation("ProviderContracts", fields: [providerId], references: [id])
  location      String?
  country       String    @default("IN")
  language      String    @default("en")
  deadline      DateTime
  aiGenerated   Boolean   @default(false)
  totalPaid     Float     @default(0)
  platformFee   Float     @default(0)
  hasInsurance  Boolean   @default(false)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments Payment[]
  reviews  Review[]
  disputes Dispute[]
}

model Payment {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String
  gateway     String
  status      String
  platformFee Float
  gatewayFee  Float
  netAmount   Float
  fromUserId  String
  toUserId    String
  createdAt   DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model Dispute {
  id          String    @id @default(cuid())
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  raisedById  String
  raisedBy    User      @relation("DisputeRaiser", fields: [raisedById], references: [id])
  againstId   String
  against     User      @relation("DisputeAgainst", fields: [againstId], references: [id])
  description String
  status      String    @default("OPEN")
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WhatsAppSession {
  id          String   @id @default(cuid())
  phone       String   @unique
  state       String
  language    String   @default("en")
  lastMessage DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
