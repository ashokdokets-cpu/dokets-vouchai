# ============================================
# VouchAI API Environment Configuration
# ============================================

# Database
DATABASE_URL="file:./prisma/vouchai.db"
# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="vouchai-super-secret-key-change-in-production-2024"
JWT_EXPIRY="30d"
JWT_REFRESH_EXPIRY="90d"

# Twilio (WhatsApp Integration)
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_WHATSAPP_NUMBER="+14155238886"

# Razorpay (India & Asia Payments)
RAZORPAY_KEY_ID="rzp_test_your_key_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# PayPal (Global Payments)
PAYPAL_CLIENT_ID="your_paypal_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret_here"
PAYPAL_MODE="sandbox" # Change to "live" for production

# Stripe (Alternative Global Payments)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# OpenAI (AI Features)
OPENAI_API_KEY="sk-your_openai_api_key_here"

# Google Cloud (Speech-to-Text & Translation)
GOOGLE_CLOUD_API_KEY="your_google_cloud_api_key"
GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account-key.json"

# Email Service (SendGrid)
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_FROM_EMAIL="noreply@vouchai.com"

# App Configuration
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
NODE_ENV="development"
PORT=3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR="uploads"