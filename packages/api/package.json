{
    "name":  "@vouchai/api",
    "version":  "1.0.0",
    "description":  "VouchAI Backend API",
    "main":  "src/index.ts",
    "scripts":  {
                    "dev":  "ts-node-dev --respawn --transpile-only src/index.ts",
                    "build":  "npx prisma generate",
                    "start":  "npx ts-node-dev --transpile-only src/index.ts",
                    "db:migrate":  "npx prisma migrate dev",
                    "db:studio":  "npx prisma studio",
                    "db:generate":  "npx prisma generate",
                    "db:push":  "npx prisma db push",
                    "db:seed":  "ts-node prisma/seed.ts"
                },
    "dependencies":  {
                         "@prisma/client":  "^5.22.0",
                         "axios":  "^1.6.0",
                         "bcryptjs":  "^2.4.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.3.0",
                         "express":  "^4.18.0",
                         "helmet":  "^7.0.0",
                         "ioredis":  "^5.3.0",
                         "jsonwebtoken":  "^9.0.0",
                         "openai":  "^4.0.0",
                         "razorpay":  "^2.9.0",
                         "stripe":  "^14.0.0",
                         "twilio":  "^4.19.0"
                     },
    "devDependencies":  {
                            "@types/express":  "^4.17.0",
                            "@types/node":  "^20.0.0",
                            "prisma":  "^5.22.0",
                            "ts-node":  "^10.9.0",
                            "ts-node-dev":  "^2.0.0",
                            "typescript":  "^5.0.0"
                        }
}
