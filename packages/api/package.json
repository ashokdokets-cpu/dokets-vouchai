{
  "name": "@vouchai/api",
  "version": "1.0.0",
  "description": "VouchAI Backend API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
