generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  name          String
  email         String?
  language      String   @default("en")
  role          String   @default("BOTH")
  country       String   @default("IN")
  vouchScore    Float    @default(100)
  vouchTier     String   @default("NEW")
  isPremium     Boolean  @default(false)
  referralCode  String   @unique
  walletBalance Float    @default(0)
  walletCurrency String  @default("INR")
  completedContracts Int  @default(0)
  totalContractsAsClient Int @default(0)
  totalContractsAsProvider Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contractsAsClient  Contract[] @relation("ClientContracts")
  contractsAsProvider Contract[] @relation("ProviderContracts")
}

model Contract {
  id          String   @id @default(cuid())
  vouchId     String   @unique
  title       String
  description String
  status      String   @default("DRAFT")
  amount      Float
  currency    String   @default("INR")
  upfrontAmount Float?
  finalAmount  Float
  clientId    String
  client      User     @relation("ClientContracts", fields: [clientId], references: [id])
  providerId  String?
  provider    User?    @relation("ProviderContracts", fields: [providerId], references: [id])
  location    String?
  country     String   @default("IN")
  language    String   @default("en")
  deadline    DateTime
  platformFee Float    @default(0)
  totalPaid   Float    @default(0)
  aiGenerated Boolean  @default(false)
  hasInsurance Boolean @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    Payment[]
}

model Milestone {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Float
  percentage  Float
  order       Int
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, VERIFIED, DISPUTED
  dueDate     DateTime?
  completedAt DateTime?
  verifiedAt  DateTime?
  proofUrl    String?
  aiVerified  Boolean  @default(false)
  aiConfidence Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String
  gateway     String
  status      String
  platformFee Float
  gatewayFee  Float
  netAmount   Float
  fromUserId  String
  toUserId    String
  createdAt   DateTime @default(now())
}